# Environment
ENVIRONMENT=development
PROJECT_NAME="Dubai BizNavigator"
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Server Configuration
HOST=0.0.0.0
PORT=8000

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dubai_biznavigator

# Langfuse Observability
LANGFUSE_PUBLIC_KEY=pk-lf-example-key
LANGFUSE_SECRET_KEY=sk-lf-example-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# LangSmith Tracing (Disabled in favor of Langfuse)
LANGSMITH_TRACING=false
LANGSMITH_OTEL_ENABLED=false

# LLM Providers
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Search API
TAVILY_API_KEY=your_tavily_api_key_here
